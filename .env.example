# Generate a private .env with: python3 scripts/setup-env.py
# Or copy this file to .env and fill all three secrets yourself.
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
# At least 32 random ASCII characters; never reuse a published example.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=120

# Local backend (run from backend/). Compose uses its internal MySQL address.
DB_URL=jdbc:mysql://localhost:3307/sportsphere?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Europe/Belgrade
DB_USERNAME=sportsphere
SERVER_PORT=8080
UPLOAD_DIRECTORY=../uploads
CORS_ALLOWED_ORIGIN=http://localhost:4200
FRONTEND_URL=http://localhost:4200

# Local backend SMTP settings. Compose always uses its private Mailpit inbox.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@sportsphere.local
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false

# Host ports published by the local Compose stack.
MYSQL_PORT=3307
BACKEND_PORT=8080
MAIL_UI_PORT=8025
